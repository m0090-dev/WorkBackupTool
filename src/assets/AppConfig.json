{
  "language": "ja",
  "alwaysOnTop": false,
  "restorePreviousState": true,
  "autoBaseGenerationThreshold": 1.0,
  "trayMode": false,
  "compactMode": false,
  "useSameDirForTemp": false,
  "trayBackupMode": "diff",
  "rebuildCacheOnStartup": true,
  "startupCacheLimit": 5,
  "showMemoAfterBackup": true,
  "strictFileNameMatch": true,
  "hdiffStrictHashCheck": true,
  "globalShortcutEnabled": false,
  "shortcutRun": "Ctrl+Alt+B",
  "shortcutRunWithMemo": "Ctrl+Alt+Shift+B",
  "shortcutBackupMode": "diff",
  "notifyEnabled": false,
  "notifyStyle": "popup",
  "notifyDurationSec": 3,
  "notifyOnlyOnFailure": false,
  "reminderEnabled": false,
  "reminderIntervalMin": 30,
  "reminderMethod": "popup",
  "reminderSkipUnchanged": true,
  "openAfterRestore": false
}
